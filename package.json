{
	"name": "waybill",
	"version": "1.0.0",
	"description": "Waybill is a URL shortner",
	"license": "MIT",
	"author": "Emmanuel Oramulu",
	"type": "module",
	"main": "src/index.js",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"start": "bun dist/index.js",
		"typecheck": "tsc --noEmit",
		"db:schema": "psql -v ON_ERROR_STOP=1 -d waybill_db -f database/schema.sql",
		"services:start": "scripts/services.sh start",
		"services:stop": "scripts/services.sh stop",
		"services:status": "scripts/services.sh status",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"dependencies": {
		"cors": "^2.8.6",
		"dotenv": "^18.0.7",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0",
		"pg": "^8.23.1",
		"redis": "^6.3.0",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/pg": "^8.23.1",
		"bun-types": "^1.4.3",
		"typescript": "^6.0.3"
	}
}
