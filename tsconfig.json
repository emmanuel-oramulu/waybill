{
	"compilerOptions": {
		"paths": { "@/*": ["./src/*"] },
		"module": "preserve",
		"moduleResolution": "bundler",
		"target": "esnext",
		"types": ["bun"],
		"noEmit": true,

		"noUncheckedIndexedAccess": true,

		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true
	},
	"include": ["src"]
}
